{
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-production-db;Port=5432;Database=mentalhealthbar;Username=your-user;Password=your-password;SSL Mode=Require"
  },
  "Cors": {
    "AllowedOrigins": [
      // IMPORTANT: Configure your actual production origins here
      // Examples:
      // "https://your-domain.com",
      // "https://app.your-domain.com"
      //
      // NEVER use:
      // - "*" (wildcard)
      // - "http://" origins in production (use HTTPS only)
      // - Development/localhost origins
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  // SECURITY: AllowedHosts must be restricted in production
  // Prevents host header injection attacks
  // Examples:
  //   - Single domain: "your-domain.com"
  //   - Multiple domains: "your-domain.com;api.your-domain.com"
  // NEVER use "*" in production
  "AllowedHosts": "your-domain.com"
}
