<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MentalHealthBar.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MentalHealthBar.Desktop.Views.ExportView"
             x:DataType="vm:ExportViewModel">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Export Data"
                   FontSize="32"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <!-- Export Options -->
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="600">
                <!-- Date Range Selection -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Select Date Range"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start Date" Margin="0,0,0,5" />
                                <DatePicker SelectedDate="{Binding StartDate}"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="End Date" Margin="0,0,0,5" />
                                <DatePicker SelectedDate="{Binding EndDate}"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick Date Range Options -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,15,0,0"
                                    Spacing="10">
                            <TextBlock Text="Quick select:"
                                       VerticalAlignment="Center" />
                            <Button Command="{Binding SetLast7DaysCommand}"
                                    Content="Last 7 days"
                                    Padding="10,5"
                                    CornerRadius="4" />
                            <Button Command="{Binding SetLast30DaysCommand}"
                                    Content="Last 30 days"
                                    Padding="10,5"
                                    CornerRadius="4" />
                            <Button Command="{Binding SetLast90DaysCommand}"
                                    Content="Last 90 days"
                                    Padding="10,5"
                                    CornerRadius="4" />
                            <Button Command="{Binding SetAllTimeCommand}"
                                    Content="All time"
                                    Padding="10,5"
                                    CornerRadius="4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Data Types Selection -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Select Data Types"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15" />

                        <CheckBox IsChecked="{Binding IncludeMoodEntries}"
                                  Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📝" FontSize="20" />
                                <StackPanel>
                                    <TextBlock Text="Mood Entries" FontWeight="SemiBold" />
                                    <TextBlock Text="Daily mood scores, tags, and notes"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding IncludeAssessments}"
                                  Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📋" FontSize="20" />
                                <StackPanel>
                                    <TextBlock Text="Assessments" FontWeight="SemiBold" />
                                    <TextBlock Text="PHQ-9, BDI, GAD-7, BAI results"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding IncludeHealthMetrics}"
                                  Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="💪" FontSize="20" />
                                <StackPanel>
                                    <TextBlock Text="Health Metrics" FontWeight="SemiBold" />
                                    <TextBlock Text="Sleep hours and water intake"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding IncludeEventLabels}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🏷️" FontSize="20" />
                                <StackPanel>
                                    <TextBlock Text="Event Labels" FontWeight="SemiBold" />
                                    <TextBlock Text="All created tags and labels"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Export Format Selection -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Export Format"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15" />

                        <RadioButton GroupName="ExportFormat"
                                     IsChecked="{Binding IsCsvSelected}"
                                     Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CSV (Comma-Separated Values)"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Best for spreadsheet applications like Excel or Google Sheets"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="400" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="ExportFormat"
                                     IsChecked="{Binding IsJsonSelected}">
                            <StackPanel>
                                <TextBlock Text="JSON (JavaScript Object Notation)"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Best for data processing, backups, or integration with other applications"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="400" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Export Summary -->
                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Export Summary"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Export {0} from {1:MMM dd, yyyy} to {2:MMM dd, yyyy}">
                                    <Binding Path="SelectedDataTypesDescription" />
                                    <Binding Path="StartDate" />
                                    <Binding Path="EndDate" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Estimated records: {0}">
                                    <Binding Path="EstimatedRecordCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10">
                    <Button Command="{Binding PreviewCommand}"
                            IsEnabled="{Binding CanExport}"
                            Width="120"
                            Height="40"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="👁️" FontSize="16" />
                            <TextBlock Text="Preview" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCommand}"
                            IsEnabled="{Binding CanExport}"
                            Width="150"
                            Height="40"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="💾" FontSize="16" />
                            <TextBlock Text="Export Data" FontSize="16" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Progress Indicator -->
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsExporting}"
                             Margin="0,20,0,0"
                             Height="4" />

                <!-- Status Messages -->
                <Border Background="LightGreen"
                        BorderBrush="Green"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,20,0,0"
                        IsVisible="{Binding ShowSuccessMessage}">
                    <StackPanel>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   HorizontalAlignment="Center"
                                   Foreground="DarkGreen"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExportedFilePath}"
                                   HorizontalAlignment="Center"
                                   Foreground="DarkGreen"
                                   FontSize="12"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- Error message placeholder - will be visible when error handling is implemented -->
                <!--<Border Background="LightCoral"
                        BorderBrush="Red"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,20,0,0"
                        IsVisible="False">
                    <TextBlock Text="Error message will appear here"
                               HorizontalAlignment="Center"
                               Foreground="DarkRed"
                               TextWrapping="Wrap" />
                </Border>-->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>